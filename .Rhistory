if(pred.int){
Lamresid = matrix(rnorm(nrow(location)*out$n.factors,
mean=rep(0,nrow(location)*out$n.factors),
sd=sqrt(rep(c(out$tau2.lambda[i]),each=out$n.factors))),ncol=out$n.factors,byrow=TRUE)
Lam[,,i] = Lammean + Lamresid
}else{
Lam[,,i] = Lammean
} #end pred.int
} #end draws loop
