install.packages("googlesheets4")
library(googlesheets4)
dat <- read_sheet("https://docs.google.com/spreadsheets/d/1tCq0N5LjpmDhUckJvpZKldBIlFp-bBWbv7Zf-oKw7mo/edit?usp=sharing")
dat <- read_sheet("https://docs.google.com/spreadsheets/d/1tCq0N5LjpmDhUckJvpZKldBIlFp-bBWbv7Zf-oKw7mo/edit?usp=sharing")
library(ggplot2)
set.seed(104)
#number of times
nT <- round(365.25*2)-1
dates <- as.Date("2001-01-01") + 1:nT
dates <- dates[seq(1, nT, by=14)]
nT <- length(dates)
doy <- lubridate::yday(dates)
# Grid of locations
nx <- 20
ny <- 20
xcoord <- seq(0,1,length=nx)
ycoord <- seq(0,1,length=ny)
coords <- expand.grid(xcoord,ycoord)
# Basis functions
distmat <- as.matrix(dist(coords))
cormat <- exp(-distmat/5)
eigvec <- eigen(cormat)$vectors[,1:5]
tempb <- temp <- fda::fourier(1:nT, nbasis=floor(nT/10))[,-1]
for(i in 1:nT){
tempb[i,] <- tempb[i,] - mean(tempb[i,])
}
knots <- seq(1, 366, length=7+1)
bs.basis <- mgcv::cSplineDes(doy, knots)
for(i in 1:dim(bs.basis)[1]){
bs.basis[i,] <- bs.basis[i,]-mean(bs.basis[i,])
}
# Coefficients
set.seed(102)
alphabeta <- rnorm(dim(eigvec)[2])
slope <- eigvec%*%alphabeta/(168)
slope <- slope + abs(min(slope))
datplot <- data.frame(x=coords[,1], y=coords[,2],slope=(slope))
p1 <- ggplot(datplot, aes(x,y,fill=slope)) +
geom_tile() +
labs(title="Slope")
p1
TT <- (-.5*nT+.5):(.5*nT-.5)
linear <- matrix(0, ncol=nx*ny, nrow=nT)
for(i in 1:(nx*ny)){
linear[,i] <- TT*slope[i]
}
range(linear)
set.seed(106)
xi <- matrix(0, nrow=nx*ny, ncol=dim(bs.basis)[2])
alphaxi <- matrix(rnorm(dim(eigvec)[2]*dim(bs.basis)[2]), nrow=dim(eigvec)[2])
for(i in 1:dim(bs.basis)[2]){
xi[,i] <- eigvec%*%alphaxi[,i]
}
season <- bs.basis%*%t(xi)
range(season)
#factors
set.seed(121)
alphaT <- matrix(rnorm(dim(tempb)[2]*4), ncol=4)
factors <- matrix(0, nrow=nT, ncol=4)
for(i in 1:4){
factors[,i] <- tempb%*%alphaT[,i]/12 #+ rnorm(nT, 0, .01)
}
for(i in 1:4){
factors[,i] <- factors[,i] - mean(factors[,i])
}
#loadings
set.seed(124)
fixed.factors <- c(
181, #west
10, #south
391, #north
220 #east
)
loads <- matrix(0, nrow=nx*ny, ncol=4)
loads[,1] <- rev(rep(c(rep(0,nx/2),seq(0,1,length=nx/2)), by=ny)+ rnorm(nx*ny,0,.01))
loads[,4] <- rep(c(rep(0,nx/2),seq(0,1,length=nx/2)), by=ny)+ rnorm(nx*ny,0,.01)
loads[,2] <- rev(rep(c(rep(0,nx/2),seq(0,1,length=nx/2)), each=ny)+ rnorm(nx*ny,0,.01))
loads[,3] <- (rep(c(rep(0,nx/2),seq(0,1,length=nx/2)), each=ny)+ rnorm(nx*ny,0,.01))
loads[fixed.factors,] <- diag(1,4)
datplot <- data.frame(x=coords[,1], y=coords[,2],slope=loads[,4])
p1 <- ggplot(datplot, aes(x,y,fill=slope)) +
geom_tile() +
labs(title="Slope")
p1
BS <- kronecker(diag(1,4), eigvec)
alphaS <- solve(t(BS)%*%BS)%*%t(BS)%*%c(loads)
loads <- matrix(BS%*%alphaS, ncol=4, byrow=F) + rnorm(nx*ny*4,0,.03)
loads[fixed.factors,] <- diag(1,4)
#FACTORS
fa <- factors%*%t(loads)
range(fa)
plot(fa[,1], type='l')
lines(fa[,2], col='red')
lines(fa[,200], col='blue')
#Residuals
set.seed(128)
resid <- matrix(rnorm(nT*nx*ny,0,.005), nrow=nT, ncol=nx*ny)
y <- linear + season + fa + resid
#Sample 100 locations to fit the model
set.seed(256)
n.locs <- 70
train <- sample(1:(nx*ny), n.locs, replace=F)
ymat <- y[,train]
coordsmat <- coords[train,]
plot(ymat[,1], type='l', ylim=range(ymat))
lines(ymat[,2])
plot(coordsmat[,1], coordsmat[,2])
coordsmat[,3] <- 1:nrow(coordsmat)
coordsmat[which(coordsmat[,1]==0),] #west
coordsmat[which(coordsmat[,2]<0.1),] #south
coordsmat[which(coordsmat[,2]>0.9),] #north
coordsmat[which(coordsmat[,1]>0.9),] #east
###############################
library(BSTFA)
set.seed(240)
ff <- c(
22, #west
20, #south
48, #north
14 #east
)
coordsmat <- coordsmat[,1:2]
out <- BSTFA(ymat=ymat, dates=dates, coords=coordsmat, iters=500, save.missing=F, factors.fixed=ff, n.temp.bases=22)
out$latlon <- FALSE
class(out) <- "bstfa"
out.sim <- out
save(out.sim, file="data/out.sim.rda")
