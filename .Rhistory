xipred <- predS.xi%*%t(out$alpha.xi)
xilong = kronecker(Matrix::Diagonal(nrow(location)),
out$model.matrices$seasonal.bs.basis)%*%xipred
m.fft.lon <- sapply(1:(sqrt(out$n.load.bases)/2), function(k) {
