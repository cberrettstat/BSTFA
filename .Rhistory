library(BSTFA)
data("utahDataList")
attach(utahDataList)
dates.ind <- 1151:1251
locs.use <- c(3, 8, 11, 16, 17,
20, 23, 29, 30, 46,
47, 49, 60, 62, 66, 73,
75, 76, 77, 78, 85, 89, 94,
96, 98, 100, 109, 112,
115, 121, 124, 128, 133, 144)
temps.sm <- TemperatureVals[dates.ind, locs.use]
coords.sm <- Coords[locs.use,]
dates.sm <- Dates[dates.ind]
locsm.names <- Locations[locs.use]
apply(temps.sm, 1, mean)
apply(temps.sm, 2, mean, na.rm=T)
locsm.names
set.seed(481)
out.sm <- BSTFA(ymat=temps.sm,
dates=dates.sm,
coords=coords.sm,
iters=5000,
burn=1000,
thin=40,
factors.fixed=c(14, 22, 15, 20),
n.temp.bases=45)
convergence_diag(out.sm)
convergence_diag(out.sm, cutoff=30)
plot_annual(out.sm, 1)
plot_annual(out.sm, matrix(coords.sm[1,], nrow=1, ncol=2))
plot_location(out.sm, 1)
plot_location(out.sm, 1, truth=T)
plot_factor(out.sm, 1:4, together=T)
plot_location(out.sm, matrix(coords.sm[1,], nrow=1, ncol=2))
plot_location(out.sm, 1)
object.size(out.sm)
?BSTFA
dim(out.sm$beta)
dim(out.sm$F.tilde)
dim(out.sm$mu)
names(out.sm)
dim(out.sm$y.missing)
set.seed(466)
out.sm <- BSTFA(ymat=temps.sm,
dates=dates.sm,
coords=coords.sm,
iters=5000,
burn=1000,
thin=40,
factors.fixed=c(14, 22, 15, 20),
n.temp.bases=45,
save.missing=FALSE)
convergence_diag(out.sm, cutoff=30)
plot_annual(out.sm, 1)
plot_factor(out.sm, 1:4, together=T)
plot_location(out.sm, 1)
plot_location(out.sm, matrix(coords.sm[1,], nrow=1, ncol=2))
usethis::use_data(out.sm)
usethis::use_data(out.sm, overwrite=TRUE)
devtools::document()
locsm.names[17]
devtools::build_vignettes()
