far = FALSE
d = c()
while (!far) {
p = sample(which(prop.missing<0.2), size=n.factors, replace=FALSE)
combos = combn(p,2)
for (i in 1:ncol(combos)) {
d[i] = distmat[combos[1,i], combos[2,i]]
}
far = ifelse(min(d) < (max(distmat) / n.factors), FALSE, TRUE)
}
factors.fixed = p
}
